<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for SoundCraft. The app is pure Rust, loads no unsigned code,
     needs no JIT, and is not sandboxed (it opens files by path, from the command line and
     drag-and-drop). Add exceptions here only with a reason in a comment. -->
<plist version="1.0">
<dict>
  <!-- Recording: the hardened runtime blocks audio input (CoreAudio via cpal) without this,
       even after the user grants microphone access (NSMicrophoneUsageDescription). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Plug-in hosting: hardened-runtime library validation rejects third-party VST3/CLAP/AU
       binaries signed by another team (Kontakt, BBC Symphony Orchestra, FabFilter…), so without
       this the app and CLI scan none of them (#153, #149). Only plug-ins the user scans load. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>

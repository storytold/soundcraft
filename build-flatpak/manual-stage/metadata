[Application]
name=ai.storyteller.soundcraft
runtime=org.freedesktop.Platform/x86_64/26.08
sdk=org.freedesktop.Sdk/x86_64/26.08
command=soundcraft

[Context]
shared=ipc;network;
sockets=fallback-x11;pulseaudio;wayland;
devices=dri;
filesystems=~/.vst3:ro;xdg-music;~/.clap:ro;

[Extension org.freedesktop.LinuxAudio.Plugins]
directory=extensions/Plugins
version=26.08
add-ld-path=lib
merge-dirs=vst3;clap
subdirectories=true
no-autodownload=true

[Environment]
CLAP_PATH=/app/extensions/Plugins/clap
VST3_PATH=/app/extensions/Plugins/vst3
